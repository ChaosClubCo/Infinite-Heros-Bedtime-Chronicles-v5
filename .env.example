# =============================================================================
# Infinity Heroes: Bedtime Chronicles — Environment Variables
# =============================================================================

# -- AI Providers --
# At least one text + one image provider is required for story generation.
# API keys are required. *_BASE_URL vars are optional overrides for proxy/custom endpoints.

# Gemini (primary text + image provider)
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# OpenAI (fallback text + image provider; also required for Voice Chat)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Anthropic Claude (fallback text provider)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# OpenRouter (fallback text provider — routes to xAI, Mistral, Cohere, Meta)
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=

# Direct OpenAI key (for video generation via Sora, optional)
OPENAI_API_KEY=

# -- Text-to-Speech --
ELEVENLABS_API_KEY=

# -- Database --
# PostgreSQL connection URL (required for Voice Chat/conversation features)
# Supabase project: aeraxfupuvwiskmfjliq (us-east-1) — tables: users, conversations, messages
# DATABASE_URL=postgresql://postgres.aeraxfupuvwiskmfjliq:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# -- Cloudflare KV (optional — enables persistent rate limiting + cross-invocation idempotency dedup) --
# When all three vars are set, the sliding-window rate limiter and the /api/generate-story
# idempotency cache use KV instead of in-memory-only state. See server/kv.ts.
# KV namespace ID: ed09afa77f9243bbb08f3dbe34df1e70 (infinity-heroes-rate-limit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# -- Cloudflare R2 (active — persistent TTS-audio cache; see server/r2.ts) --
# Keeps TTS audio durable across stateless runtime restarts/cold starts by backing
# the ephemeral /tmp cache with R2 object storage. R2_ENABLED turns on only when ALL
# of CLOUDFLARE_ACCOUNT_ID (above) + these three are set; otherwise the TTS route
# silently falls back to /tmp-only. Wired via server/routes/tts.ts.
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# -- Sentry (optional — enables error monitoring) --
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# -- GitHub webhook (optional — enables POST /api/github/webhook) --
# Must match the "Secret" configured on the repo webhook (Settings → Webhooks).
GITHUB_WEBHOOK_SECRET=

# -- Server Config --
# SESSION_SECRET=your-secret-here
# PORT=5000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=10
# TTS_CACHE_MAX_AGE_MS=86400000
# STORY_MAX_TOKENS=8192
# SUGGEST_MAX_TOKENS=2048

# -- Runtime release identity --
# Required for deployment certification. The hosting/deploy adapter must bind these
# from immutable provider/release metadata; do not populate them from request headers.
# Missing values are reported as "unknown" by /api/health and fail release provenance.
RELEASE_SHA=
RELEASE_REPO=
RELEASE_REF=
DEPLOYMENT_ENV=
RELEASE_VERSION=

# -- Feature Flags --
# FEATURE_VIDEO_ENABLED=false
# FEATURE_VOICE_CHAT_ENABLED=false
# FEATURE_STREAMING_ENABLED=true
# FEATURE_CONTENT_SAFETY_ENABLED=true
# FEATURE_CONTENT_SAFETY_LLM=false
# FEATURE_CONTENT_SAFETY_STRICT=false

# Voice Chat text generation happens before approved text is narrated.
# VOICE_CHAT_TEXT_MODEL=gpt-4o-mini

# -- Voice Chat Production Compliance Gate --
AI_PROVIDER_DPA_CONFIRMED=false
AI_PROVIDER_CHILD_DATA_PROCESSING_APPROVED=false
PRIVACY_POLICY_PUBLISHED=false
APP_STORE_DATA_SAFETY_REVIEWED=false
VOICE_CHAT_TRANSCRIPT_RETENTION_DAYS=

# -- Client Config --
# EXPO_PUBLIC_API_URL=https://your-api-server.example.com

# -- Supabase Auth --
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side (SECRET — set as a server/deployment secret; never in any EXPO_PUBLIC var or the client bundle)
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from Supabase dashboard → Project Settings → API>
# In production, if the Supabase URL + service-role key are unset, all /api routes requiring auth return 503. No opt-out.

# -- Set automatically by Replit — do not set manually --
# REPLIT_DEV_DOMAIN=
# REPLIT_DOMAINS=
# REPL_IDENTITY=
# WEB_REPL_RENEWAL=
# REPLIT_CONNECTORS_HOSTNAME=

# -- Set by Expo dev script — do not set manually --
# EXPO_PUBLIC_DOMAIN=

# -- Copilot MCP agent secrets (server-only; never expose to client bundles) --
# Required only when using the MCP-backed repository custom agents (docs/ai/MCP-AGENT-SUITE.md).
# COPILOT_MCP_SUPABASE_PROJECT_REF=
# COPILOT_MCP_SUPABASE_ACCESS_TOKEN=
# COPILOT_MCP_SENTRY_ACCESS_TOKEN=
