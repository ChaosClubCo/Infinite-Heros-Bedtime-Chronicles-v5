# Infinity Heroes — example environment configuration
# Copy to .env and replace placeholders with real values for your environment.

# AI providers
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=
OPENAI_API_KEY=

# Runtime + observability
NODE_ENV=development
PORT=5000
EXPO_PUBLIC_API_URL=http://localhost:5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
TTS_CACHE_MAX_AGE_MS=86400000
TTS_CACHE_MAX_SIZE_BYTES=524288000
FEATURE_VIDEO_ENABLED=false
FEATURE_VOICE_CHAT_ENABLED=false
FEATURE_STREAMING_ENABLED=true
FEATURE_CONTENT_SAFETY_ENABLED=true
FEATURE_CONTENT_SAFETY_LLM=false
FEATURE_CONTENT_SAFETY_STRICT=false
FEATURE_REALTIME_MEDIA_ENABLED=false
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# Text-to-speech + optional media features
ELEVENLABS_API_KEY=

# Database (required for voice-chat persistence)
DATABASE_URL=
VOICE_CHAT_TRANSCRIPT_RETENTION_DAYS=30

# Supabase auth (optional in development, required for auth-gated prod routes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare KV (optional persistent rate limit / idempotency)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 (optional durable TTS cache)
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# GitHub integration webhook
GITHUB_WEBHOOK_SECRET=

# Optional Copilot agent MCP integration tokens (server-only)
COPILOT_MCP_SUPABASE_PROJECT_REF=
COPILOT_MCP_SUPABASE_ACCESS_TOKEN=
COPILOT_MCP_SENTRY_ACCESS_TOKEN=
