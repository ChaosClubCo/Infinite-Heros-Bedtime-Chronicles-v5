{
  "auditLevel": "critical",
  "maxFileSizeBytes": 1048576,
  "ignoreDirectories": [
    ".git",
    "node_modules",
    "server_dist",
    "dist",
    "coverage",
    "archive/artifacts",
    "archive/attached_assets",
    "agents"
  ],
  "ignoreGlobs": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.md",
    "package-lock.json"
  ],
  "secretPatterns": [
    {
      "id": "openai-key",
      "regex": "(?:^|[^A-Za-z0-9])sk-[A-Za-z0-9]{20,}"
    },
    {
      "id": "github-token",
      "regex": "gh[pousr]_[A-Za-z0-9]{20,}"
    },
    {
      "id": "aws-access-key",
      "regex": "AKIA[0-9A-Z]{16}",
      "caseSensitive": true
    },
    {
      "id": "api-key-assignment",
      "regex": "(api[_-]?key|token|secret)\\s*[:=]\\s*['\"][A-Za-z0-9_\\-]{16,}['\"]"
    }
  ]
}
