{
  "name": "@krosebrook/infinite-heros-bedtime-chronicles-v5",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "repository": "https://github.com/ChaosClubCo/Infinite-Heros-Bedtime-Chronicles-v5",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "postinstall": "patch-package || cd .",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --bundle --format=cjs --outdir=server_dist --minify --external:openai --external:elevenlabs --external:@google/genai --external:@anthropic-ai/sdk --external:@supabase/supabase-js --external:drizzle-orm --external:drizzle-orm/node-postgres --external:pg --external:@sentry/node --external:express --external:pino --external:pino-std-serializers --external:zod --external:drizzle-zod --external:@aws-sdk/client-s3",
    "gcp-build": "npm run expo:static:build && npx expo export --platform web --output-dir static-build && npm run server:build",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "start": "npm run server:prod",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "typecheck": "npx tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "audit:fix": "npm audit fix --omit=dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:components": "jest",
    "preflight": "node scripts/preflight.js",
    "dev:server": "NODE_ENV=development node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:expo": "EXPO_PUBLIC_API_URL=http://localhost:5000 npx expo start --web",
    "dev": "npm run dev:server & npm run dev:expo",
    "expo:check": "npx expo install --check",
    "expo:build:ci": "npx expo export --platform web --output-dir static-build",
    "deploy:vercel": "bash scripts/deploy-vercel.sh"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 <23",
    "npm": "11.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@expo-google-fonts/bangers": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@google/genai": "^2.16.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@sentry/node": "^10.69.0",
    "@sentry/react-native": "~7.11.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "@ungap/structured-clone": "^1.3.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "elevenlabs": "^1.59.0",
    "eslint": "10.8.1",
    "eslint-config-expo": "~55.0.1",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-av": "^16.0.8",
    "expo-blur": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-router": "~55.0.17",
    "expo-speech": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.20",
    "expo-web-browser": "~55.0.18",
    "express": "^5.0.1",
    "http-proxy-middleware": "^4.1.1",
    "openai": "^7.4.0",
    "p-limit": "7.3.1",
    "p-retry": "^4.6.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "tsx": "^4.23.11",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/ngrok": "^4.1.0",
    "@react-native/metro-babel-transformer": "~0.83.10",
    "@react-native/metro-config": "~0.83.10",
    "@testing-library/react-native": "^14.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/pg": "^8.21.0",
    "@types/react": "~19.2.18",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-jest": "^29.7.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-714736e-20250131",
    "drizzle-kit": "^0.31.10",
    "eas-cli": "^21.7.1",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "msw": "^2.15.0",
    "patch-package": "^8.0.0",
    "react-test-renderer": "19.2.0",
    "supertest": "^7.2.2",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.8.3"
  },
  "private": true,
  "overrides": {
    "yaml": "^2.8.3",
    "p-retry": "^4.6.2",
    "shell-quote": "^1.8.4",
    "undici": "^6.27.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "esbuild": "$esbuild",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "eas-cli": {
      "ajv": "^8.18.0",
      "diff": "^8.0.3",
      "joi": "^17.13.4",
      "ts-deepmerge": "^8.0.0"
    },
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.4",
    "fast-uri@3": "^3.1.5",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "minimatch@5": "^5.1.9",
    "nanoid@3": "^3.3.18"
  }
}
